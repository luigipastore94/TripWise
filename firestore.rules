rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: trips
// Document ID: {inviteCode} (normalized uppercase alphanumeric + hyphens, matching ^[A-Z0-9-]{4,40}$, e.g. TW-JAPA-9X2K)
// Fields:
//   - id: string (required, 1..80 chars) - Client trip identifier
//   - inviteCode: string (required, immutable, must equal {inviteCode} doc ID) - Secret collaboration invite code
//   - title: string (required, 1..150 chars) - Trip title
//   - destination: string (required, 1..150 chars) - Destination label
//   - emoji: string (required, 1..16 chars) - Trip icon emoji
//   - coverImage: string (optional, if present 0..500000 chars) - Base64 data URL or external cover image URL
//   - startDate: string (required, 0..20 chars) - ISO start date string
//   - endDate: string (required, 0..20 chars) - ISO end date string
//   - baseCurrency: string (required, 1..10 chars) - Base currency ISO code (e.g. EUR)
//   - destinationCurrency: string (required, 1..10 chars) - Destination currency ISO code (e.g. JPY)
//   - exchangeRate: number (required, > 0 and <= 1000000000) - Currency conversion rate
//   - defaultCenter: list (required, size == 2, [lat, lng] numbers) - Default map center coordinates
//   - members: list (required, size <= 50) - Trip participants metadata (no emails/PII)
//   - memberUids: list of strings (required, size 1..50) - Collaborating Firebase Auth UIDs
//   - days: list (required, size <= 65) - Itinerary days and activities
//   - savedPlaces: list (optional, if present size <= 500) - Saved places bucket
//   - expenses: list (required, size <= 1000) - Shared trip expenses
//   - bookings: list (required, size <= 300) - Reservations and tickets
//   - checklist: list (required, size <= 500) - Pre-departure checklist items
//   - customChecklistCategories: list (optional, if present size <= 50) - Custom user-defined checklist categories
//   - updatedAt: number (required, > 0 and <= 99999999999999) - Unix epoch timestamp in ms
//
// Subcollection: trips/{inviteCode}/attachments
// Document ID: {attachmentId} (alphanumeric, hyphens, and underscores, matching ^[a-zA-Z0-9_-]{1,100}$, e.g. book_abc123 or book_abc123_chunk_1)
// Fields:
//   - bookingId: string (required, 1..80 chars) - Associated booking identifier
//   - fileName: string (optional, if present 0..255 chars) - Original file name
//   - fileSize: number (optional, if present int or float >= 0) - Total file size in bytes
//   - totalChunks: integer (optional, if present 1..25) - Total chunks count for multi-part attachment
//   - chunkIndex: integer (required, 0..24) - Zero-based chunk index
//   - chunkData: string (required, 1..800000 chars) - Chunk binary data (Base64 encoded string)
//   - mimeType: string (optional, if present 0..100 chars) - Attachment MIME type (e.g. application/pdf)
//   - updatedAt: number (required, > 0 and <= 99999999999999) - Unix epoch timestamp in ms
//
// Collection: daily_quotas
// Document ID: {dateId} (ISO date string YYYY-MM-DD, matching ^[0-9]{4}-[0-9]{2}-[0-9]{2}$)
// Fields:
//   - count: integer (required, >= 0 and <= 100000) - Shared daily usage counter
//   - updatedAt: number (required, unix timestamp ms) - Epoch timestamp in milliseconds
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is signed in via Firebase Authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if a value is an integer or floating-point number in CEL
    function isNumber(val) {
      return val is int || val is float;
    }

    // Validate string type and character length bounds [minLen, maxLen]
    function isValidString(val, minLen, maxLen) {
      return val is string &&
             val.size() >= minLen &&
             val.size() <= maxLen;
    }

    // Validate list type and maximum element count
    function isValidList(val, maxSize) {
      return val is list && val.size() <= maxSize;
    }

    // Validate [lat, lng] geographic coordinate tuple
    function isValidCoordinates(coords) {
      return coords is list &&
             coords.size() == 2 &&
             isNumber(coords[0]) &&
             coords[0] >= -90 &&
             coords[0] <= 90 &&
             isNumber(coords[1]) &&
             coords[1] >= -180 &&
             coords[1] <= 180;
    }

    // Validate normalized inviteCode document ID pattern
    function isValidInviteCode(code) {
      return code is string &&
             code.matches('^[A-Z0-9-]{4,40}$');
    }

    // Validate attachment document ID pattern (alphanumeric, hyphens, underscores, length 1..100)
    function isValidAttachmentDocId(attachmentId) {
      return attachmentId is string &&
             attachmentId.matches('^[a-zA-Z0-9_-]{1,100}$');
    }

    // Validate daily quota document ID pattern (ISO date string YYYY-MM-DD)
    function isValidDailyQuotaDocId(dateId) {
      return dateId is string &&
             dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Verify all required top-level fields exist on the incoming document
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Enforce strict schema so no arbitrary/extraneous fields can be injected
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Ensure specified fields have not been modified during an update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Check if the authenticated caller is already in the stored trip's memberUids
    function isExistingTripMember() {
      return isAuthenticated() &&
             (resource.data.memberUids is list) &&
             (request.auth.uid in resource.data.memberUids);
    }

    // Check if the authenticated caller is a member of the trip identified by inviteCode
    function isTripMember(inviteCode) {
      return isAuthenticated() &&
             isValidInviteCode(inviteCode) &&
             exists(/databases/$(database)/documents/trips/$(inviteCode)) &&
             (get(/databases/$(database)/documents/trips/$(inviteCode)).data.memberUids is list) &&
             (request.auth.uid in get(/databases/$(database)/documents/trips/$(inviteCode)).data.memberUids);
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidTripData(data, inviteCode) {
      return hasOnlyAllowedFields(data, [
               'id',
               'inviteCode',
               'title',
               'destination',
               'emoji',
               'coverImage',
               'startDate',
               'endDate',
               'baseCurrency',
               'destinationCurrency',
               'exchangeRate',
               'defaultCenter',
               'members',
               'memberUids',
               'days',
               'savedPlaces',
               'expenses',
               'bookings',
               'checklist',
               'customChecklistCategories',
               'updatedAt'
             ]) &&
             hasRequiredFields(data, [
               'id',
               'inviteCode',
               'title',
               'destination',
               'emoji',
               'startDate',
               'endDate',
               'baseCurrency',
               'destinationCurrency',
               'exchangeRate',
               'defaultCenter',
               'members',
               'memberUids',
               'days',
               'expenses',
               'bookings',
               'checklist',
               'updatedAt'
             ]) &&
             isValidInviteCode(inviteCode) &&
             data.inviteCode is string &&
             data.inviteCode == inviteCode &&
             isValidString(data.id, 1, 80) &&
             isValidString(data.title, 1, 150) &&
             isValidString(data.destination, 1, 150) &&
             isValidString(data.emoji, 1, 16) &&
             (!('coverImage' in data) || isValidString(data.coverImage, 0, 500000)) &&
             isValidString(data.startDate, 0, 20) &&
             isValidString(data.endDate, 0, 20) &&
             isValidString(data.baseCurrency, 1, 10) &&
             isValidString(data.destinationCurrency, 1, 10) &&
             isNumber(data.exchangeRate) &&
             data.exchangeRate > 0 &&
             data.exchangeRate <= 1000000000 &&
             isValidCoordinates(data.defaultCenter) &&
             isValidList(data.members, 50) &&
             (data.memberUids is list) &&
             data.memberUids.size() >= 1 &&
             data.memberUids.size() <= 50 &&
             isValidString(data.memberUids[0], 1, 128) &&
             isValidList(data.days, 65) &&
             (!('savedPlaces' in data) || isValidList(data.savedPlaces, 500)) &&
             isValidList(data.expenses, 1000) &&
             isValidList(data.bookings, 300) &&
             isValidList(data.checklist, 500) &&
             (!('customChecklistCategories' in data) || isValidList(data.customChecklistCategories, 50)) &&
             isNumber(data.updatedAt) &&
             data.updatedAt > 0 &&
             data.updatedAt <= 99999999999999;
    }

    // Case A: Existing trip member collaborating on the trip without removing themselves
    function isAuthorizedMemberCollaboration() {
      return isExistingTripMember() &&
             (request.auth.uid in request.resource.data.memberUids);
    }

    // Case B: Authenticated companion joining via exact secret inviteCode
    function isAuthorizedCompanionJoin() {
      return (resource.data.memberUids is list) &&
             !(request.auth.uid in resource.data.memberUids) &&
             request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
             request.resource.data.memberUids.hasOnly(
               resource.data.memberUids.concat([request.auth.uid])
             ) &&
             request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
             (request.auth.uid in request.resource.data.memberUids) &&
             (resource.data.members is list) &&
             request.resource.data.members.size() >= resource.data.members.size() &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'memberUids',
               'members',
               'updatedAt'
             ]);
    }

    // Case C: Existing trip member voluntarily removing themselves from the shared trip
    function isAuthorizedMemberLeave() {
      return isExistingTripMember() &&
             !(request.auth.uid in request.resource.data.memberUids) &&
             resource.data.memberUids.hasAll(request.resource.data.memberUids) &&
             resource.data.memberUids.size() == request.resource.data.memberUids.size() + 1 &&
             request.resource.data.memberUids.size() >= 1 &&
             (resource.data.members is list) &&
             request.resource.data.members.size() <= resource.data.members.size() &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'memberUids',
               'members',
               'updatedAt'
             ]);
    }

    // Domain Validator for /trips/{inviteCode}/attachments/{attachmentId} (Used in BOTH create and update)
    function isValidAttachmentData(data) {
      return hasOnlyAllowedFields(data, [
               'bookingId',
               'fileName',
               'fileSize',
               'totalChunks',
               'chunkIndex',
               'chunkData',
               'mimeType',
               'updatedAt'
             ]) &&
             hasRequiredFields(data, [
               'bookingId',
               'chunkIndex',
               'chunkData',
               'updatedAt'
             ]) &&
             isValidString(data.bookingId, 1, 80) &&
             (!('fileName' in data) || isValidString(data.fileName, 0, 255)) &&
             (!('fileSize' in data) || (isNumber(data.fileSize) && data.fileSize >= 0)) &&
             (!('totalChunks' in data) || (data.totalChunks is int && data.totalChunks >= 1 && data.totalChunks <= 25)) &&
             data.chunkIndex is int &&
             data.chunkIndex >= 0 &&
             data.chunkIndex <= 24 &&
             isValidString(data.chunkData, 1, 800000) &&
             (!('mimeType' in data) || isValidString(data.mimeType, 0, 100)) &&
             isNumber(data.updatedAt) &&
             data.updatedAt > 0 &&
             data.updatedAt <= 99999999999999;
    }

    // Domain Validator for /daily_quotas/{dateId} (Used in BOTH create and update)
    function isValidDailyQuotaData(data) {
      return data.keys().hasOnly(['count', 'updatedAt']) &&
             data.count is int &&
             data.count >= 0 &&
             data.count <= 100000 &&
             isNumber(data.updatedAt);
    }

    // ===============================================================
    // Collection Rules: /trips/{inviteCode}
    // ===============================================================

    match /trips/{inviteCode} {
      // Allow single-document lookup / real-time listener by exact inviteCode for authenticated users
      // (supports joining via invite link/code and subscribing before initial cloud push)
      allow get: if isAuthenticated();

      // Prevent trip enumeration: users may only query/list trips where their UID is in memberUids
      allow list: if isAuthenticated() &&
                     (request.auth.uid in resource.data.memberUids);

      // Creating a trip requires authentication, valid TripData schema, and caller UID in memberUids
      allow create: if isAuthenticated() &&
                       isValidTripData(request.resource.data, inviteCode) &&
                       (request.auth.uid in request.resource.data.memberUids);

      // Updating a trip requires authentication, immutable inviteCode, valid TripData schema,
      // and either existing-member collaboration (Case A), companion self-join (Case B), or voluntary member departure (Case C)
      allow update: if isAuthenticated() &&
                       request.resource.data.inviteCode == resource.data.inviteCode &&
                       areImmutableFieldsUnchanged(['inviteCode']) &&
                       isValidTripData(request.resource.data, inviteCode) &&
                       (isAuthorizedMemberCollaboration() ||
                        isAuthorizedCompanionJoin() ||
                        isAuthorizedMemberLeave());

      // Only existing trip members may delete a trip document
      allow delete: if isExistingTripMember();

      // =============================================================
      // Subcollection Rules: /trips/{inviteCode}/attachments/{attachmentId}
      // =============================================================

      match /attachments/{attachmentId} {
        // Members of the parent trip can read (get and list) booking attachments
        allow get, list: if isTripMember(inviteCode);

        // Members of the parent trip can create attachment chunks with valid schema
        allow create: if isTripMember(inviteCode) &&
                         isValidAttachmentDocId(attachmentId) &&
                         isValidAttachmentData(request.resource.data);

        // Members of the parent trip can update attachment chunks with valid schema
        allow update: if isTripMember(inviteCode) &&
                         isValidAttachmentDocId(attachmentId) &&
                         isValidAttachmentData(request.resource.data);

        // Members of the parent trip can delete attachment chunks
        // (also allows cleaning up orphaned attachments if parent trip document was deleted)
        allow delete: if isTripMember(inviteCode) ||
                         (isAuthenticated() && !exists(/databases/$(database)/documents/trips/$(inviteCode)));
      }
    }

    // ===============================================================
    // Collection Rules: /daily_quotas/{dateId}
    // ===============================================================

    match /daily_quotas/{dateId} {
      // Allow authenticated users to read (get and list) shared daily quota status
      allow read: if isAuthenticated();

      // Creating a daily quota requires authentication, valid ISO date document ID, and strict schema
      allow create: if isAuthenticated() &&
                       isValidDailyQuotaDocId(dateId) &&
                       isValidDailyQuotaData(request.resource.data);

      // Updating a daily quota requires authentication, valid ISO date document ID, and strict schema
      allow update: if isAuthenticated() &&
                       isValidDailyQuotaDocId(dateId) &&
                       isValidDailyQuotaData(request.resource.data);
    }

    // ===============================================================
    // Default Deny Catch-All
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
